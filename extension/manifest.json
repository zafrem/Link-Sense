{
  "manifest_version": 3,
  "name": "Link Sense",
  "version": "0.1.0",
  "description": "Review ranked browser history and bookmark the pages you actually use.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "bookmarks",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Link Sense"
  }
}
